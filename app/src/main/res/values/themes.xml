<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BatteryGuard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorSurface">@color/bg_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/accent_low</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <style name="Theme.BatteryGuard.Alert" parent="Theme.BatteryGuard">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
